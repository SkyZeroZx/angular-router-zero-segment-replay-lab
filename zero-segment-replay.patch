+        path: 'a',
+        component: ComponentA,
+        children: [{path: ':id', outlet: 'detail', component: ComponentB}],
+      },
+    ];
+
+    function withNgDevMode<T>(value: unknown, fn: () => T): T {
+      const previous = (globalThis as any).ngDevMode;
+      (globalThis as any).ngDevMode = value;
+      try {
+        return fn();
+      } finally {
+        (globalThis as any).ngDevMode = previous;
+      }
+    }
+
+    // A parenthesised group that consumes no segments is passed to
+    // `processChildren` with the same config, so the same route matches once per
+    // group and every match lands in one sibling array under one outlet name.
+    it('rejects duplicates when ngDevMode is off', async () => {
+      await withNgDevMode(false, () =>
+        expectAsync(recognize(config, 'a/(detail:1//x:/(detail:1))')).toBeRejected(),
+      );
+    });
+
+    // `mergeEmptyPathMatches` moves the children of duplicate empty path nodes
+    // under one node. Those children are the duplicates, and they are created
+    // below the level the caller validated.
+    it('rejects duplicates that only appear once empty path matches are merged', async () => {
+      const merging: Routes = [
+        {
+          path: '',
+          component: ComponentA,
